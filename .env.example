# このファイルをコピーして .env を作る
#   Mac/Linux : cp .env.example .env
#   Windows   : copy .env.example .env
#
# .env は .gitignore で除外されている。コミットしないこと。
# ここに書く値はローカル開発用であり、本番想定の秘密情報は入れない。

# === PostgreSQL（docker compose が読む） ===
POSTGRES_USER=torano
POSTGRES_PASSWORD=torano_dev_password
POSTGRES_DB=torano_maki
# 標準の5432を避けている。ネイティブのPostgreSQLが動いている環境だと
# 接続がそちらに吸われ、原因の分かりにくい認証エラーになるため。
POSTGRES_PORT=5433
ADMINER_PORT=8080

# === バックエンドが読む ===
# バックエンドはコンテナ外（ホスト）で動かすため localhost を指す。
# POSTGRES_PORT を変更した場合はこちらのポート番号も合わせること。
DATABASE_URL=postgresql+psycopg://torano:torano_dev_password@localhost:5433/torano_maki

# === LLM（DGX Spark 上の vLLM / OpenAI互換API） ===
# BASE_URL は末尾の /v1 まで含める。
# 例: http://192.168.128.142:8080/v1
# MODEL_NAME は配信中の ID 以外だと 404 になる。
# 例: Qwen3.8-27B-NVFP4
# 空のままだと extraction.py が「未設定」として弾く。
#   モデルIDの確認: curl $BASE_URL/models
BASE_URL=
MODEL_NAME=

# === 埋め込み ===
# 各自のPCのCPUで実行する。DGX上のvLLMは固定モデルのみ配信しており、
# 埋め込みモデルを載せられないため（docs/decisions.md 参照）。
# 初回実行時にモデル（約2.2GB）が自動ダウンロードされる。
#
# EMBEDDING_DIM は docker/initdb/02_schema.sql の vector(N) と必ず一致させること。
# 不一致は /health/db の embedding_dim_matches で検知できる。
# 変更する場合は DB の作り直しが必要:
#   docker compose down -v && docker compose up -d
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
